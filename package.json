{
  "name": "boleto",
  "version": "1.0.0",
  "description": "Application de gestion des demandes de support permettant aux clients de créer des tickets, aux agents de les traiter et aux administrateurs de gérer les utilisateurs.",
  "main": "api/index.js",
  "scripts": {
    "dev": "concurrently \"tsc --watch\" \"nodemon dist/infrastructure/adapters/http/server.js\"",
    "build": "tsc && npm run build:frontend",
    "build:frontend": "esbuild src/frontend/src/main.ts --bundle --format=iife --outfile=dist/frontend/app.js",
    "start": "node dist/infrastructure/adapters/http/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "vercel-build": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felikarina/boleto.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/felikarina/boleto/issues"
  },
  "homepage": "https://github.com/felikarina/boleto#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "serverless-http": "^4.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.5.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "jest": "^30.5.1",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
