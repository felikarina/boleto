{
  "version": 2,
  "builds": [
    {
      "src": "src/infrastructure/adapters/http/server.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/infrastructure/adapters/http/server.ts"
    },
    {
      "src": "/(.*)",
      "dest": "src/infrastructure/adapters/http/server.ts"
    }
  ]
}